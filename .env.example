# ====================================================================
# Cambium Enterprise Research Operating System — Environment Template
# NEVER COMMIT SENSITIVE VALUES OR PRODUCTION SECRETS TO GIT
# ====================================================================

# 1. Application Core
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# 2. Zero-Trust JWT Authentication & Rotating Refresh Cookies
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# 3. PostgreSQL Database with pgvector Extension (SSOT)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=cambium
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/cambium

# 4. Redis Cluster (BullMQ Queues, Socket.io Adapter, Token Revocation, Rate Limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 5. External AI Reasoning & Intelligence APIs (Optional / Staging)
GEMINI_API_KEY=your_google_gemini_api_key_here
