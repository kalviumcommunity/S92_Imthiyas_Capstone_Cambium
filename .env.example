# ==============================================================================
# Cambium Enterprise Research Operating System — Root Environment Template
# SAFE DEFAULTS FOR LOCAL DEV — NEVER COMMIT PRODUCTION CREDENTIALS
# ==============================================================================

# 1. Runtime & Networking (Server-only unless prefixed NEXT_PUBLIC_)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAME_SITE=lax
API_REQUEST_TIMEOUT_MS=20000

# 2. JWT Dual-Token Authentication (Generate unique >=32-char secrets in production)
JWT_SECRET=change_me_local_dev_jwt_access_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_local_dev_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# 3. PostgreSQL 16 + pgvector (768-dim HNSW) System of Record
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cambium
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cambium
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=false
DB_SYNCHRONIZE=false

# 4. Optional Redis (Auto-falls back to L1 memory + Postgres background_jobs when omitted)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# 5. Optional External AI, Email & OAuth Providers (Offline deterministic fallbacks active if unset)
GEMINI_API_KEY=your_google_gemini_api_key_here
RESEND_API_KEY=
GOOGLE_CLIENT_ID=dummy-client-id-for-dev.apps.googleusercontent.com

# 6. Public Client Configuration (Exposed to browser via Next.js bundle)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=dummy-client-id-for-dev.apps.googleusercontent.com
