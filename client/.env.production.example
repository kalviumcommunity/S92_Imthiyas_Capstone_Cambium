# ==============================================================================
# CAMBIUM FRONTEND UI (Next.js 15 App Router)
# PRODUCTION ENVIRONMENT VAULT CONFIGURATION (.env.production.example)
# ==============================================================================
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# ==============================================================================

# Public Backend REST API Base URL (HTTPS)
NEXT_PUBLIC_API_URL=https://api.cambium.edu/api/v1

# Public Client Application URL (Canonical Origin)
NEXT_PUBLIC_APP_URL=https://cambium.edu

# WebSockets / Real-Time Collaboration Gateway (WSS)
NEXT_PUBLIC_WS_URL=wss://api.cambium.edu
NEXT_PUBLIC_SOCKET_URL=https://api.cambium.edu

# Production Environment Tag
NEXT_PUBLIC_ENVIRONMENT=production

# Google Cloud OAuth 2.0 Client ID (Browser Sign-In)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Optional: Google Gemini API Key for client-side playground
NEXT_PUBLIC_GEMINI_API_KEY=

# Sentry Frontend Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=
