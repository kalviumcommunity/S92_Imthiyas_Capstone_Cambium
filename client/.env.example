# ==============================================================================
# CAMBIUM FRONTEND CLIENT — ENVIRONMENT TEMPLATE (client/.env.example)
# BROWSER-EXPOSED VARIABLES (NEXT_PUBLIC_*) — NEVER PLACE SECRETS HERE
# ==============================================================================

# Backend REST API v1 Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public Client Web Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSockets / Real-Time Collaboration Gateway URL
NEXT_PUBLIC_WS_URL=http://localhost:5000

# Google OAuth Client ID (Optional public client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=dummy-client-id-for-dev.apps.googleusercontent.com

# Deployment Site Metadata URL (SEO / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
