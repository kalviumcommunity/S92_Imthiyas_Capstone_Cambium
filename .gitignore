# ==============================================================================
# CAMBIUM ENTERPRISE RESEARCH OS — MASTER GITIGNORE
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Production Builds & Compilation Caches
dist/
*/dist/
**/dist/
.next/
*/.next/
**/.next/
out/
*/out/
**/out/
*.tsbuildinfo
**/*.tsbuildinfo
.turbo/
.swc/

# Environment Variables & Secrets (Comprehensive Git Leak Shield)
.env
.env.*
*/.env
*/.env.*
**/.env
**/.env.*
!.env.example
!.env.production.example
!server/.env.example
!server/.env.production.example
!client/.env.example
!client/.env.production.example

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating System & IDE Configurations
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Automated Test & Quality Gate Artifacts
test-results/
playwright-report/
.playwright-mcp/
coverage/
.nyc_output/

# Research Artifact File Storage & Backups
server/uploads/artifacts/*
!server/uploads/artifacts/.gitkeep
backups/*
!backups/.gitkeep

# Legacy Design Sandboxes & Prototype Spikes
_vite_raw_code/
*.backup.*
*.bak
