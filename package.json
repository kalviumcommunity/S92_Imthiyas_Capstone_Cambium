{
  "name": "cambium-monorepo",
  "version": "2.0.0",
  "description": "Cambium — AI-Powered Research Opportunity Discovery & Intelligence Platform",
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "init:db": "npm --prefix server run init:db",
    "schema:apply": "npm --prefix server run schema:apply",
    "seed": "npm --prefix server run seed",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently --kill-others-on-fail \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm run server:build && npm run client:build",
    "test": "npm --prefix server run test",
    "test:jest": "jest --runInBand",
    "test:e2e": "playwright test",
    "verify:env": "node scripts/verify-env.mjs",
    "verify:env:prod": "node scripts/verify-env.mjs --production",
    "verify:db": "node scripts/verify-db.mjs",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "verify:proxy": "node scripts/verify-proxy.mjs",
    "health": "node scripts/health-check.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:ai": "node scripts/verify-ai-autocomplete.mjs"
  },
  "keywords": [
    "cambium",
    "nestjs",
    "postgresql",
    "pgvector",
    "typeorm",
    "ai",
    "semantic-search"
  ],
  "author": "Shaik Mohamed Imthiyas T",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15"
  }
}
