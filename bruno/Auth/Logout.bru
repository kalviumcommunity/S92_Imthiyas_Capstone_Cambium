meta {
  name: Logout Scholar
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("should revoke session cleanly", function() {
    expect(res.getStatus()).to.be.oneOf([200, 204]);
  });
}
