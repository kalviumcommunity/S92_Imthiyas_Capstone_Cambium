meta {
  name: OpenAPI / Swagger JSON Specification
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/docs-json
  body: none
  auth: none
}

tests {
  test("should return valid OpenAPI 3.0 specification", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.openapi).to.match(/^3\./);
    expect(body.info.title).to.include('Cambium');
  });
}
