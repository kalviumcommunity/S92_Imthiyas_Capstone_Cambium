# ==============================================================================
# CAMBIUM BACKEND ENTERPRISE API (NestJS 10)
# PRODUCTION ENVIRONMENT VAULT CONFIGURATION (.env.production.example)
# ==============================================================================
# STRICT ENFORCEMENT:
# In production, inject secrets via environment variables or cloud secret managers.
# Never commit active credentials to Git.
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://cambium.edu,https://www.cambium.edu,https://api.cambium.edu

# Cryptographic Token Secrets (Must be at least 64 hex characters)
JWT_SECRET=replace_with_64_char_hex_high_entropy_secret_0123456789abcdef012345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_64_char_hex_high_entropy_refresh_key_0123456789abcdef
JWT_REFRESH_EXPIRES_IN=7d
AUDIT_HMAC_SECRET=replace_with_64_char_hex_high_entropy_audit_key_0123456789abcdef

# PostgreSQL 16 + pgvector Database Configuration
DATABASE_URL=postgresql://cambium_admin:CHANGE_THIS_PRODUCTION_PASSWORD@db.cambium.internal:5432/cambium?sslmode=require
POSTGRES_HOST=db.cambium.internal
POSTGRES_PORT=5432
POSTGRES_USER=cambium_admin
POSTGRES_PASSWORD=CHANGE_THIS_PRODUCTION_PASSWORD
POSTGRES_DB=cambium
DB_SSL=true
DB_SYNCHRONIZE=false
DB_LOGGING=error
DB_POOL_MAX=50

# PgBouncer & Read Replica (Optional)
# POSTGRES_PGBOUNCER_PORT=6432
# POSTGRES_REPLICA_HOST=replica-db.cambium.internal
# POSTGRES_REPLICA_PORT=5432
# POSTGRES_REPLICA_USER=cambium_readonly
# POSTGRES_REPLICA_PASSWORD=CHANGE_THIS_REPLICA_PASSWORD

# Distributed Redis 7+
REDIS_URL=rediss://default:CHANGE_THIS_REDIS_PASSWORD@redis.cambium.internal:6379
REDIS_HOST=redis.cambium.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Google Gemini AI Embedding Engine
GEMINI_API_KEY=AIzaSy_YOUR_LIVE_GEMINI_PRODUCTION_API_KEY_HERE

# OpenAlex Polite Pool
OPENALEX_POLITE_EMAIL=imthiyas@cambium.research

# Resend Transactional Email Gateway
RESEND_API_KEY=re_live_YOUR_LIVE_RESEND_PRODUCTION_KEY_HERE
EMAIL_FROM=Cambium Intelligence <scholar@cambium.research>

# Federated Authentication
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
SAML_ENTRY_POINT=https://idp.university.edu/idp/profile/SAML2/Redirect/SSO
SAML_ISSUER=https://cambium.edu/saml/metadata
SAML_CERT="MIID...YOUR_BASE64_X509_CERTIFICATE"
SAML_SP_ENTITY_ID=https://cambium.edu/saml/metadata
SAML_ACS_URL=https://api.cambium.edu/api/auth/saml/acs

# Observability & Cloudflare Purging
SENTRY_DSN=https://your_sentry_key@o00000.ingest.sentry.io/000000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

