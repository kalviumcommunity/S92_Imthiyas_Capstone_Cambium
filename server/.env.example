# Application Port & Environment
PORT=5000
NODE_ENV=development

# JWT Authentication (Zero-Trust Rotating Dual-Token Architecture)
JWT_SECRET=cambium_jwt_secret_key_2026_change_in_production
JWT_REFRESH_SECRET=cambium_jwt_refresh_secret_key_2026_super_secure_change_in_production

# CORS Configuration (Comma-separated allowed origins or wildcard for development)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL & pgvector Configuration (Cambium System of Record)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cambium
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cambium

# Redis & BullMQ Queues (Distributed Sockets, SSE, Idempotency & Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 Credentials (Optional for local dev)
GOOGLE_CLIENT_ID=dummy-client-id-for-dev.apps.googleusercontent.com
