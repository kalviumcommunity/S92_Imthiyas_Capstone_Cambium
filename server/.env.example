# ==============================================================================
# CAMBIUM BACKEND API — ENVIRONMENT TEMPLATE (server/.env.example)
# SERVER-ONLY VARIABLES — DO NOT EXPOSE TO CLIENT BUNDLES
# ==============================================================================

# 1. Server Runtime & HTTP Safety
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAME_SITE=lax
API_REQUEST_TIMEOUT_MS=20000

# 2. JWT Authentication & Refresh Cookies
JWT_SECRET=change_me_local_dev_jwt_access_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_local_dev_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# 3. PostgreSQL 16 + pgvector (768-dim HNSW & GIN FTS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cambium
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cambium
POSTGRES_PGBOUNCER_PORT=
POSTGRES_REPLICA_HOST=
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=false
DB_SYNCHRONIZE=false

# 4. Optional Redis (Auto-falls back to L1 Map + Postgres SKIP LOCKED queue if unavailable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# 5. Google Gemini AI (gemini-2.0-flash & gemini-embedding-001 768-dim)
GEMINI_API_KEY=

# 6. Email Delivery (Resend; logs simulated outbox messages locally when unset)
RESEND_API_KEY=

# 7. Google OAuth 2.0 & Institutional SAML 2.0 (Optional)
GOOGLE_CLIENT_ID=dummy-client-id-for-dev.apps.googleusercontent.com
SAML_ENTRY_POINT=https://idp.institution.edu/idp/profile/SAML2/Redirect/SSO
SAML_ISSUER=urn:cambium:enterprise:scholar-sp
SAML_CERT=

# 8. OpenTelemetry OTLP Export (Optional; local TelemetryService metrics remain active without OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
