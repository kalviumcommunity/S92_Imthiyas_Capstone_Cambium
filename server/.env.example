# Application Port & Environment
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=cambium_secret_key_jwt_token_2026

# PostgreSQL & pgvector Configuration (Cambium System of Record)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cambium

# Full PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cambium

# Redis & BullMQ Queues (Caching, Rate Limiting & Background Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
