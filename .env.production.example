# ==============================================================================
# CAMBIUM ENTERPRISE RESEARCH OPERATING SYSTEM (v2.0.0 GA)
# MASTER PRODUCTION ENVIRONMENT VAULT SPECIFICATION (.env.production.example)
# ==============================================================================
# SECURITY NOTICE:
# 1. NEVER commit real production secrets, private keys, or passwords to Git.
# 2. In production, inject these secrets via AWS Secrets Manager, HashiCorp Vault,
#    Doppler, Railway, or Kubernetes Sealed Secrets.
# 3. All HMAC and JWT secrets MUST possess at least 256 bits of entropy (64 hex characters).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
# Comma-separated list of fully-qualified HTTPS production origins (Strict CORS):
CORS_ORIGIN=https://cambium.edu,https://www.cambium.edu,https://api.cambium.edu

# ------------------------------------------------------------------------------
# 2. ZERO-TRUST CRYPTOGRAPHIC IDENTITY & ROTATING REFRESH TOKENS
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_high_entropy_secret_0123456789abcdef012345
JWT_EXPIRES_IN=15m

# Dedicated refresh token HMAC key (independent rotation cycle):
JWT_REFRESH_SECRET=replace_with_64_char_hex_high_entropy_refresh_key_0123456789abcdef
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic Audit Ledger HMAC Secret (Recursive Merkle Chain validation):
AUDIT_HMAC_SECRET=replace_with_64_char_hex_high_entropy_audit_key_0123456789abcdef

# ------------------------------------------------------------------------------
# 3. PRODUCTION POSTGRESQL 16 + PGVECTOR (SYSTEM OF RECORD)
# ------------------------------------------------------------------------------
# Unified Connection URI (AWS RDS / Supabase / Neon / Cloud SQL):
DATABASE_URL=postgresql://cambium_admin:CHANGE_THIS_PRODUCTION_PASSWORD@db.cambium.internal:5432/cambium?sslmode=require

# Explicit Connection Parameters (Fallback & Micro-tuning):
POSTGRES_HOST=db.cambium.internal
POSTGRES_PORT=5432
POSTGRES_USER=cambium_admin
POSTGRES_PASSWORD=CHANGE_THIS_PRODUCTION_PASSWORD
POSTGRES_DB=cambium

# Transport Layer Security & Schema Protection:
DB_SSL=true
DB_SYNCHRONIZE=false
DB_LOGGING=error
DB_POOL_MAX=50

# Optional: High-Throughput PgBouncer Pool & Read Replica Routing:
# POSTGRES_PGBOUNCER_PORT=6432
# POSTGRES_REPLICA_HOST=replica-db.cambium.internal
# POSTGRES_REPLICA_PORT=5432
# POSTGRES_REPLICA_USER=cambium_readonly
# POSTGRES_REPLICA_PASSWORD=CHANGE_THIS_REPLICA_PASSWORD

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED REDIS 7+ (WEBSOCKETS, SSE, RATE LIMITING, BULLMQ)
# ------------------------------------------------------------------------------
# Unified Redis URI with TLS (rediss://):
REDIS_URL=rediss://default:CHANGE_THIS_REDIS_PASSWORD@redis.cambium.internal:6379

# Explicit Redis Parameters:
REDIS_HOST=redis.cambium.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# 5. EXTERNAL AI & SCHOLARLY REASONING ENGINES
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Pro & text-embedding-004 API Key:
GEMINI_API_KEY=AIzaSy_YOUR_LIVE_GEMINI_PRODUCTION_API_KEY_HERE

# OpenAlex Polite Pool Courtesy Email (Unlocks 100 req/sec academic rate limits):
OPENALEX_POLITE_EMAIL=imthiyas@cambium.research

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL SCHOLAR NOTIFICATIONS (RESEND API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_live_YOUR_LIVE_RESEND_PRODUCTION_KEY_HERE
EMAIL_FROM=Cambium Intelligence <scholar@cambium.research>

# ------------------------------------------------------------------------------
# 7. FEDERATED AUTHENTICATION (GOOGLE OAUTH 2.0 & INCOMMON SAML 2.0)
# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Client ID:
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Institutional SAML 2.0 / Shibboleth Single Sign-On:
SAML_ENTRY_POINT=https://idp.university.edu/idp/profile/SAML2/Redirect/SSO
SAML_ISSUER=https://cambium.edu/saml/metadata
SAML_CERT="MIID...YOUR_BASE64_X509_CERTIFICATE"
SAML_SP_ENTITY_ID=https://cambium.edu/saml/metadata
SAML_ACS_URL=https://api.cambium.edu/api/auth/saml/acs

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & EDGE TELEMETRY
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_key@o00000.ingest.sentry.io/000000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318

# Cloudflare Edge Cache Purging:
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 9. PUBLIC CLIENT URLS (NEXT.JS 15 RUNTIME CONSUMPTION)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.cambium.edu/api/v1
NEXT_PUBLIC_APP_URL=https://cambium.edu
NEXT_PUBLIC_WS_URL=wss://api.cambium.edu
NEXT_PUBLIC_SOCKET_URL=https://api.cambium.edu
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
